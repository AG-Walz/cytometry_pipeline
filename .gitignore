# =============================================================================
# Cytometry Pipeline .gitignore
# =============================================================================

# ======================== CLAUDE / AI FILES =================================
CLAUDE.md
**/CLAUDE.md
.claude/

# ======================== R-SPECIFIC IGNORES ================================
.Rhistory
.RData
.Rproj.user
*.Rproj
.Renviron
.Rprofile

# ======================== PYTHON-SPECIFIC IGNORES ===========================
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
*.egg-info/
.eggs/

# ======================== DATA FILES (Large, not for Git) ===================
# FCS files (flow cytometry data - usually large)
*.fcs

# Workspace files
*.wsp

# Spreadsheet/tabular data
*.csv
*.xlsx
*.xls
*.tsv

# R data files
*.rds
*.RData

# ======================== OUTPUT FILES ======================================
Output/
*.log
*.pdf
*.png
*.svg
*.jpg
*.jpeg
*.tiff
*.gif

# ======================== EDITOR/IDE FILES ==================================
.vscode/
*.code-workspace
.idea/
*.sublime-*

# ======================== ARCHIVE & OLD VERSIONS ============================
archive/

# ======================== PROJECT-SPECIFIC EXCLUDES =========================
# FlowJo test workspace (data copied to test_data/)
FlowJo tests/

# Gating comparison data
Gating_comparisons/

# Python scripts (not part of main R pipeline)
Python_scripts/

# Temporary/generated files
*.tmp
*.temp
*~
.DS_Store
Thumbs.db

# Log files from analysis runs
heatmap_log.txt
output_log.txt
cluster_extraction.log
gate_stats.csv

# Comparison script (temporary)
compare_scripts.py

# ======================== EXCEPTIONS (Files to INCLUDE) =====================
# These patterns override the above ignores

# Include test_data example CSVs (small, needed for tests)
!test_data/**
!test_data/examples/*.csv

# Include README files everywhere
!README.md
!**/README.md

# Include all R scripts in subproject directories
!R_shared/**/*.R
!loading/**/*.R
!preprocessing/**/*.R
!harmonization/**/*.R
!clustering/**/*.R
!analysis/**/*.R
!visualization/**/*.R
!metadata_qc/**/*.R
!pipelines/**/*.R
!config/**/*.R
