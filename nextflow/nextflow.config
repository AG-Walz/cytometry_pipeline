/*
 * Cytometry Pipeline — Nextflow Configuration
 *
 * Usage:
 *   nextflow run nextflow/main.nf --pipeline A --input_dir /data/fcs ...
 *   nextflow run nextflow/main.nf -params-file config/pipeline_A_params.yaml
 */

includeConfig 'conf/base.config'

params {
    // Pipeline selection: A, B, C, D, or E
    pipeline = null

    // --- Paths (required) ---
    input_dir             = null
    output_dir            = './results'
    conditions_csv        = null
    // Removed: samplesheet, chunk_size (unused; resource scaling handled by conf/base.config)

    // --- Markers (required for pipelines A, B, E) ---
    markers_of_interest   = null          // comma-separated: "CD3,CD4,CD8,CD19"
    markername_replacing  = null          // JSON string: '{"old":"new"}'

    // --- Methods (swappable) ---
    clustering_method     = 'leiden'      // leiden, flowsom, phenograph, dbscan
    batch_method          = 'none'        // harmony, cytonorm, combat, none
    dimred_method         = 'umap'        // umap, tsne, diffusion_map
    transform_type        = 'arcsinh'     // arcsinh, logicle, biexponential, log
    analysis_method       = 'enrichment'  // enrichment, abundance

    // --- Conditions / Metadata ---
    condition_levels      = 'Control,Treatment'
    sample_names          = null          // comma-separated
    batch_names           = null          // comma-separated
    patient_names         = null

    // --- Loading ---
    truncation            = false

    // --- Preprocessing ---
    pp_order              = 'QT'          // QT or TQ
    qc_type               = 'None'        // None, flowAI, PeacoQC
    quant_norm            = false
    scaling               = false

    // --- Downsampling ---
    downsample_method     = 'Consistent'  // Consistent or Maximal
    downsample_n          = 10000

    // --- Clustering ---
    n_neighbors           = 15
    resolution            = 0.5
    n_clusters            = 20
    grid_xdim             = 10
    grid_ydim             = 10
    dbscan_eps            = null
    dbscan_min_pts        = 5

    // --- Batch correction ---
    batch_do_pca          = false
    combat_method         = 'parametric'
    cytonorm_n_clusters   = 10
    cytonorm_goal         = 'mean'

    // --- Dimensionality reduction ---
    umap_min_dist         = 0.1
    tsne_perplexity       = 30
    tsne_max_iter         = 1000

    // --- Analysis ---
    cluster_regex         = 'Clustering annotated'
    gating_pattern        = '\\(Clustering annotated\\)$|^Clustering raw$'
    processing_mode       = 'manual'
    min_cluster_size      = 5
    p_adjust_method       = 'BH'
    alpha_level           = 0.05
    stat_method           = 'pooled'
    test_type             = 'lmer'
    exclude_patterns      = ''
    cytolution_metadata_file = null

    // --- Output ---
    output_formats        = 'png'         // png, pdf, svg, or png,pdf
    plot_width            = 10
    plot_height           = 8
    save_intermediates    = false

    // --- Memory ---
    max_cells_per_file    = 500000
    max_cells_heatmap     = 5000

    // --- Reproducibility ---
    seed                  = 42

    // --- Pipeline D specific ---
    wsp_paths             = null          // comma-separated workspace paths
    wsp_names             = null          // comma-separated workspace names
    target_fcs            = null
    label_dict            = null          // JSON string
}

// Process defaults (resource labels defined in conf/base.config with dynamic scaling)
process {
    container = 'ghcr.io/ag-walz/cytometry-pipeline:1.0.0'
}

// Execution profiles
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
    }
    local {
        docker.enabled = false
        singularity.enabled = false
    }
    slurm {
        process.executor = 'slurm'
    }
    test {
        // Alias for test_E (kept for backwards compatibility)
        params {
            pipeline            = 'E'
            input_dir           = "${projectDir}/../test_data/fcs_samples"
            output_dir          = "${projectDir}/../test_output"
            markers_of_interest = 'CD3,CD4,CD8,CD19,CD56'
            downsample_n        = 30
            n_neighbors         = 5
            seed                = 42
        }
        process {
            cpus   = 1
            memory = '2 GB'
            time   = '10m'
        }
    }
    test_A {
        params {
            pipeline            = 'A'
            input_dir           = "${projectDir}/../test_data/fcs_samples"
            output_dir          = "${projectDir}/../test_output_A"
            conditions_csv      = "${projectDir}/../test_data/fcs_samples/conditions.csv"
            markers_of_interest = 'CD3,CD4,CD8,CD19,CD56'
            downsample_n        = 30
            n_neighbors         = 5
            seed                = 42
        }
        process {
            cpus   = 1
            memory = '2 GB'
            time   = '10m'
        }
    }
    test_B {
        params {
            pipeline            = 'B'
            input_dir           = "${projectDir}/../test_data/csv_expression"
            output_dir          = "${projectDir}/../test_output_B"
            markers_of_interest = 'CD3,CD4,CD8,CD19,CD56,HLA-DR'
            n_neighbors         = 5
            seed                = 42
        }
        process {
            cpus   = 1
            memory = '2 GB'
            time   = '10m'
        }
    }
    test_C {
        params {
            pipeline            = 'C'
            input_dir           = "${projectDir}/../test_data/csv_gating"
            output_dir          = "${projectDir}/../test_output_C"
            conditions_csv      = "${projectDir}/../test_data/csv_gating_conditions.csv"
            markers_of_interest = 'CD3,CD4,CD8,CD19,CD56,HLA-DR'
            seed                = 42
        }
        process {
            cpus   = 1
            memory = '2 GB'
            time   = '10m'
        }
    }
    test_D {
        // Pipeline D requires FlowJo .wsp files — no WSP files ship in test_data/.
        // To run locally, set --wsp_paths and --wsp_names on the command line.
        params {
            pipeline            = 'D'
            output_dir          = "${projectDir}/../test_output_D"
            seed                = 42
        }
        process {
            cpus   = 1
            memory = '2 GB'
            time   = '10m'
        }
    }
    test_E {
        params {
            pipeline            = 'E'
            input_dir           = "${projectDir}/../test_data/fcs_samples"
            output_dir          = "${projectDir}/../test_output_E"
            markers_of_interest = 'CD3,CD4,CD8,CD19,CD56'
            downsample_n        = 30
            n_neighbors         = 5
            seed                = 42
        }
        process {
            cpus   = 1
            memory = '2 GB'
            time   = '10m'
        }
    }
}

// Reports
timeline {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/trace.txt"
    overwrite = true
}

// Manifest
manifest {
    name            = 'AG-Walz/cytometry_pipeline'
    author          = 'AG Walz'
    description     = 'Modular flow cytometry analysis pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
