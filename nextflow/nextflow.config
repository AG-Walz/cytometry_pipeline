/*
 * Cytometry Pipeline — Nextflow Configuration
 *
 * Usage:
 *   nextflow run nextflow/main.nf --pipeline A --input_dir /data/fcs ...
 *   nextflow run nextflow/main.nf -params-file nextflow/conf/pipeline_A_params.yaml
 */

params {
    // Pipeline selection: A, B, C, D, or E
    pipeline = null

    // --- Paths (required) ---
    input_dir             = null
    output_dir            = './results'
    conditions_csv        = null
    samplesheet           = null          // optional nf-core-style samplesheet

    // --- Markers (required for pipelines A, B, E) ---
    markers_of_interest   = null          // comma-separated: "CD3,CD4,CD8,CD19"
    markername_replacing  = null          // JSON string: '{"old":"new"}'

    // --- Methods (swappable) ---
    clustering_method     = 'leiden'      // leiden, flowsom, phenograph, dbscan
    batch_method          = 'none'        // harmony, cytonorm, combat, none
    dimred_method         = 'umap'        // umap, tsne, diffusion_map
    transform_type        = 'arcsinh'     // arcsinh, logicle, biexponential, log
    analysis_method       = 'enrichment'  // enrichment, abundance

    // --- Conditions / Metadata ---
    condition_levels      = 'Control,Treatment'
    sample_names          = null          // comma-separated
    batch_names           = null          // comma-separated
    patient_names         = null

    // --- Loading ---
    truncation            = false

    // --- Preprocessing ---
    pp_order              = 'QT'          // QT or TQ
    qc_type               = 'None'        // None, flowAI, PeacoQC
    quant_norm            = false
    scaling               = false

    // --- Downsampling ---
    downsample_method     = 'Consistent'  // Consistent or Maximal
    downsample_n          = 10000

    // --- Clustering ---
    n_neighbors           = 15
    resolution            = 0.5
    n_clusters            = 20
    grid_xdim             = 10
    grid_ydim             = 10
    dbscan_eps            = null
    dbscan_min_pts        = 5

    // --- Batch correction ---
    batch_do_pca          = false
    combat_method         = 'parametric'
    cytonorm_n_clusters   = 10
    cytonorm_goal         = 'mean'

    // --- Dimensionality reduction ---
    umap_min_dist         = 0.1
    umap_metric           = 'euclidean'   // euclidean, cosine, manhattan, ...
    tsne_perplexity       = 30
    tsne_max_iter         = 1000

    // --- Analysis ---
    cluster_regex         = 'Clustering annotated'
    gating_pattern        = '\\(Clustering annotated\\)$|^Clustering raw$'
    processing_mode       = 'manual'
    min_cluster_size      = 5
    p_adjust_method       = 'BH'
    alpha_level           = 0.05
    stat_method           = 'pooled'
    test_type             = 'lmer'
    exclude_patterns      = ''
    cytolution_metadata_file = null

    // --- Output ---
    output_formats        = 'png'         // png, pdf, svg, or png,pdf
    plot_width            = 10
    plot_height           = 8

    // --- Memory ---
    chunk_size            = 50000
    max_cells_per_file    = 500000

    // --- Reproducibility ---
    seed                  = 42

    // --- Pipeline D specific ---
    wsp_paths             = null          // comma-separated workspace paths
    wsp_names             = null          // comma-separated workspace names

    // --- Pipeline F specific (FlowJo population -> shared UMAP) ---
    wsp                   = null          // a .wsp file, or a FOLDER of them
    fcs_dir               = null          // FCS root, searched recursively
    population            = 'Lymphocytes/Single Cells/Viable cells'
    population_map        = null          // per-workspace gates: "wsA=/g;wsB=/h"
    group                 = '1'           // group index, or its NAME
    // How a workspace's samples are paired with FCS files. 'content' tries the
    // file name first, then pairs the rest on the $FIL keyword inside each file
    // plus its event count — which survives a rename on disk. 'strict' makes a
    // name mismatch final.
    match_mode            = 'content'
    // Comma-separated workspace names to USE; null means every one found.
    workspaces            = null
    allow_missing_samples = false
    // Spellings to treat as one marker, "INFy=IFN;TNFa=TNF". Workspaces that
    // disagree about a name share no panel at all, and no joint embedding is
    // possible until they are reconciled. Nothing is merged automatically.
    marker_aliases        = null
    // Fill in marker names from the detector when a file carries no $PnS.
    recover_markers       = true
    subpop_mode           = 'furthest'    // furthest, cd4cd8, direct, deepest, none
    subpop_select         = null          // explicit gate set, overrides the mode
    normalize             = 'none'        // none, zscore, minmax
    downsample            = 0             // max cells per sample AFTER gating
    sample_metadata       = null
    sample_pattern        = null
    annotate              = null
    point_size            = 0.4
    point_alpha           = 0.6
    target_fcs            = null
    label_dict            = null          // JSON string
}

// Process defaults
process {
    container = 'ghcr.io/ag-walz/cytometry-pipeline:latest'

    withLabel: 'process_low' {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = '32 GB'
        time   = '6h'
    }
}

// Execution profiles
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
    }
    local {
        docker.enabled = false
        singularity.enabled = false
    }
    slurm {
        process.executor = 'slurm'
    }
    test {
        params {
            pipeline            = 'E'
            input_dir           = "${projectDir}/../test_data/fcs_samples"
            output_dir          = "${projectDir}/../test_output"
            markers_of_interest = 'CD3,CD4,CD8,CD19,CD56'
            downsample_n        = 30
            n_neighbors         = 5
            seed                = 42
        }
        process {
            cpus   = 1
            memory = '2 GB'
            time   = '10m'
        }
    }
}

// Reports
timeline {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.output_dir}/pipeline_info/trace.txt"
    overwrite = true
}

// Manifest
manifest {
    name            = 'AG-Walz/cytometry_pipeline'
    author          = 'AG Walz'
    description     = 'Modular flow cytometry analysis pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
