/*
 * conf/local.config — run every process natively inside the `cytometry_env`
 * conda environment, with no Docker or Singularity.
 *
 * Intended for laptops, workstations and WSL2. Combine it with a params file:
 *
 *   nextflow run nextflow/main.nf \
 *       -c nextflow/conf/local.config \
 *       -params-file nextflow/conf/pipeline_E_params.yaml
 *
 * Requires Nextflow >= 24.04 (for `resourceLimits`).
 */

env {
    // Where the R sources live. The nextflow/bin/*_cli.R wrappers read this;
    // their built-in default (/opt/cytometry/src) only exists in the container.
    CYTOMETRY_SRC = "${projectDir}/../src"
}

docker.enabled      = false
singularity.enabled = false

process {
    container = null

    // The `process_high` label asks for 32 GB / 8 CPUs, which is more than most
    // laptops have — Nextflow would refuse to schedule it. These caps scale every
    // request down to what the machine actually has. Raise them on a big server.
    resourceLimits = [ memory: 8.GB, cpus: 4, time: 4.h ]
}
