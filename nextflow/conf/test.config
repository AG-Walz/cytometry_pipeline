/*
 * Test profile — minimal resources, synthetic data
 */

params {
    pipeline            = 'E'
    input_dir           = "${projectDir}/../test_data/fcs_samples"
    output_dir          = "${projectDir}/../test_output"
    markers_of_interest = 'CD3,CD4,CD8,CD19,CD56'
    downsample_n        = 30
    n_neighbors         = 5
    seed                = 42
}

process {
    cpus   = 1
    memory = '2 GB'
    time   = '10m'
}
