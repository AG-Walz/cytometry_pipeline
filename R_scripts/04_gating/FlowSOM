# ========================= PARAMETERS =========================

fallback_dir <- "/home/ngr24/Desktop/Maerklin/Cytometry/R_scripts"
input_file_path <- "/data/Maerklin/ICK/ICK_T1_PR/"
output_dir <- "/data/Maerklin/ICK/ICK_T1_PR/Results"
project_name <- "ICK_T1_PR"

# Marker selection options:
# - "popup": Open GUI window for interactive marker selection
# - "terminal": Choose from all filtered markers in terminal
# - "all": Use all filtered markers
# - vector of marker names: Use specific markers (e.g. c("CD4", "CD8", "TNF"))
# - vector of column numbers: Use specific columns (e.g. c(5, 7, 9))
MARKER_SELECTION_MODE <- "popup"  # Change this to control marker selection

# Patterns to use to filter out markers
EXCLUDE_PATTERNS <- c("^$", "ALD", "Column", "index", "Time", "FSC", "SSC")

# Output format options: Choose which formats to generate
# Set to TRUE for formats you want, FALSE to skip
# You can choose any combination: none, one, two, or all three formats
OUTPUT_FORMATS <- list(
  pdf = TRUE,    # Vector format for publications (scalable, small file size)
  png = TRUE,    # Raster format for pwp (high quality, larger file size)
  svg = TRUE     # Vector format for web (scalable, editable)
)

# Plot dimensions (inches)
PLOT_WIDTH <- 8
PLOT_HEIGHT <- 6
PNG_DPI <- 300  # Resolution for PNG files

# ========================= SETUP =========================
# Set working directory to script location
setwd(fallback_dir)

source_files <- c("Packages.R", "Functions.R", "UMAP_functions.R",
                  "Downsampling_functions.R") # UMAP.R

lapply(source_files, source, chdir = TRUE)

# Setup output directory
results_path <- "/data/Maerklin/ICK/ICK_T1_PR/Results"
umap_dir <- paste0(results_path, "/umap_plots/")
dir_create(c(results_path, umap_dir))

# ========================= DIRECT FCS LOADING =========================

# Load FCS files into flow frames and extract sample names
flow_frames <- load_fcs_folder(input_file_path)

# ========================= MARKER SELECTION =========================
# Get marker information and filter markers
marker_info <- explore_data(flow_frames[[1]])

# Filter out empty/unnamed markers and uninteresting ones
all_markers <- marker_info$markers[marker_info$mcols]
all_indices <- marker_info$mcols

# Apply filtering using base R to avoid namespace conflicts
exclude_regex <- paste(EXCLUDE_PATTERNS, collapse = "|")
keep_mask <- !grepl(exclude_regex, all_markers, ignore.case = TRUE)
filtered_markers <- all_markers[keep_mask]
filtered_indices <- all_indices[keep_mask]

# Simplified marker selection
marker_indices_of_interest <- select_markers_by_mode(MARKER_SELECTION_MODE,
                                                     filtered_markers,
                                                     filtered_indices)

cat("Final markers to use for UMAP:", length(marker_indices_of_interest),
    "markers | Indices:", paste(marker_indices_of_interest, collapse = ", "),
    "\n")
## ========================= FLOW-SOM CLUSTERING (NO TRANSFORM / NO SCALE) =========================

suppressPackageStartupMessages({
  library(FlowSOM)
  library(flowCore)
  library(data.table)
})

set.seed(1)

# ---- Tunables (safe defaults for big datasets) ----
N_META_CLUSTERS <- 30          # final number of clusters
SOM_XY            <- c(10, 10) # SOM grid ~100 codes is fine for ~30 meta clusters
RLEN              <- 10        # SOM training iterations
MAX_TRAIN_PER_FILE <- 10000    # REDUCED: subsample PER FILE (was 100000)
CHUNK_SIZE         <- 50000    # REDUCED: map cells in chunks (was 500000)
MAX_TOTAL_TRAIN    <- 50000    # NEW: max total training cells across all files

# Memory safety check
gc()
cat("Initial memory usage:\n")
print(gc())

# Sanity: selected markers (indices)
stopifnot(length(marker_indices_of_interest) > 0)

# ---- Get marker names for the selected indices ----
marker_names <- marker_info$markers[marker_indices_of_interest]
# Replace empty/NA names with generic names
marker_names[marker_names == "" | is.na(marker_names)] <- 
  paste0("Marker_", marker_indices_of_interest[marker_names == "" | is.na(marker_names)])

# ---- Helper: get a readable sample name for each flowFrame ----
get_sample_name <- function(ff, fallback = NULL) {
  nm <- tryCatch({
    n <- keyword(ff)$`$FIL`
    if (is.null(n) || n == "") n <- keyword(ff)$FILENAME
    if (is.null(n) || n == "") n <- description(ff)$FCSfilename
    n
  }, error = function(e) NULL)
  if (is.null(nm) || nm == "") {
    if (!is.null(fallback)) return(fallback)
    return(paste0("sample_", as.integer(runif(1, 1e6, 9e6))))
  }
  basename(nm)
}

# Try to use list names; otherwise derive from FCS keywords
sample_names <- names(flow_frames)
if (is.null(sample_names) || any(sample_names == "")) {
  sample_names <- vapply(seq_along(flow_frames), function(i) {
    get_sample_name(flow_frames[[i]], fallback = paste0("sample_", i))
  }, character(1))
}

# ---- 1) Build SOM on a memory-safe pooled subsample (no transform, no scale) ----
message("Building memory-safe SOM on pooled subsample...")

sub_list <- vector("list", length(flow_frames))
total_train_cells <- 0

for (i in seq_along(flow_frames)) {
  # Safety check - don't exceed total training limit
  if (total_train_cells >= MAX_TOTAL_TRAIN) {
    message("Reached max training cells limit, stopping subsample collection")
    break
  }
  
  ff <- flow_frames[[i]]
  M  <- exprs(ff)[, marker_indices_of_interest, drop = FALSE]  # no transform/scale
  n  <- nrow(M)
  
  # Calculate how many cells to take from this file
  remaining_budget <- MAX_TOTAL_TRAIN - total_train_cells
  take <- min(n, MAX_TRAIN_PER_FILE, remaining_budget)
  
  if (take > 0) {
    idx  <- if (n > take) sample.int(n, take) else seq_len(n)
    sub_list[[i]] <- M[idx, , drop = FALSE]
    total_train_cells <- total_train_cells + take
        message("File ", i, ": took ", take, " cells (total: ", total_train_cells, ")")
  }
  
  rm(M); gc()
}

# Remove empty list elements
sub_list <- sub_list[!sapply(sub_list, is.null)]

train_data <- do.call(rbind, sub_list)
rm(sub_list); gc()

message("Training on ", nrow(train_data), " cells total")

# Wrap as a flowFrame for FlowSOM's pipeline with proper column names
train_ff <- flowFrame(as.matrix(train_data))
# Set parameter names properly for FlowSOM - create named vector
param_names <- colnames(exprs(train_ff))
names(marker_names) <- param_names
flowCore::markernames(train_ff) <- marker_names
rm(train_data); gc()

input_obj <- FlowSOM::ReadInput(train_ff, transform = FALSE, scale = FALSE, compensate = FALSE)
fsom      <- FlowSOM::BuildSOM(input_obj,
                               colsToUse = seq_len(ncol(exprs(train_ff))),
                               xdim = SOM_XY[1], ydim = SOM_XY[2],
                               rlen = RLEN)
fsom      <- FlowSOM::BuildMST(fsom)

# Meta-cluster the SOM codes to the requested number of clusters
meta <- FlowSOM::metaClustering_consensus(fsom$map$codes, k = N_META_CLUSTERS, seed = 1)

# ---- 2) Map EVERY cell to a meta-cluster (chunked; no transform / no scale) ----
message("Mapping all cells to meta-clusters (chunked)...")

# Initialize output containers BEFORE the loop
expr_blocks      <- vector("list", length(flow_frames))  # expression matrix blocks
meta_blocks      <- vector("list", length(flow_frames))  # cluster labels per cell
cellid_blocks    <- vector("list", length(flow_frames))  # cell ids per cell
provenance_blocks<- vector("list", length(flow_frames))  # file name per cell

for (i in seq_along(flow_frames)) {
  cat("=== STARTING FILE ", i, " of ", length(flow_frames), " ===\n")
  message("Processing file ", i, " of ", length(flow_frames))
  
  ff  <- flow_frames[[i]]
  nm  <- sample_names[i]
  M   <- exprs(ff)[, marker_indices_of_interest, drop = FALSE]  # selected markers only
  n   <- nrow(M)
  
  message("File ", i, " has ", n, " cells")

  # Chunked mapping to SOM codes, then to meta clusters
  start_idx <- seq(1, n, by = CHUNK_SIZE)
  lab_vec   <- integer(n)
  
  cat("Processing ", length(start_idx), " chunks for file ", i, "\n")
  message("Processing ", length(start_idx), " chunks for file ", i)

  for (j in seq_along(start_idx)) {
    s <- start_idx[j]
    e <- min(s + CHUNK_SIZE - 1, n)
    
    if (j %% 5 == 0) {
      cat("  Chunk ", j, " of ", length(start_idx), " (cells ", s, "-", e, ")\n")
      message("  Chunk ", j, " of ", length(start_idx))
    }
    
    chunk <- M[s:e, , drop = FALSE]
    # Map to closest SOM code (BMU)
    chunk_ff <- flowCore::flowFrame(as.matrix(chunk))
    chunk_param_names <- colnames(exprs(chunk_ff))
    names(marker_names) <- chunk_param_names
    flowCore::markernames(chunk_ff) <- marker_names

    # Map chunk to the existing SOM without any preprocessing
    fsom_chunk <- FlowSOM::NewData(
      fsom,
      chunk_ff,
      compensate = FALSE,
      transform  = FALSE,
      scale      = FALSE
    )

    # Cluster (SOM node) for each event in this chunk
    bmu <- FlowSOM::GetClusters(fsom_chunk)

    # Convert node -> metacluster
    lab_vec[s:e] <- meta[bmu]
    
    # Clean up chunk objects
    rm(chunk, chunk_ff, fsom_chunk, bmu)
    if (j %% 10 == 0) {
      cat("    Memory cleanup at chunk ", j, "\n")
      gc()
    }
  }

  cat("=== COMPLETED CHUNKED PROCESSING FOR FILE ", i, " ===\n")

  # Store outputs for this file
  cat("Storing results for file ", i, "\n")
  expr_blocks[[i]]       <- M                      # expression (markers of interest only)
  meta_blocks[[i]]       <- lab_vec                # integer cluster labels
  cellid_blocks[[i]]     <- paste0(nm, ":", seq_len(n))  # stable cell ids
  provenance_blocks[[i]] <- rep(nm, n)

  # clean up
  rm(M, lab_vec); gc()
  cat("=== COMPLETED FILE ", i, " ===\n")
  message("Completed file ", i)
}

# ---- 3) Assemble final outputs ----
cat("=== ASSEMBLING FINAL OUTPUTS ===\n")
cat("Combining expression blocks...\n")
expr_matrix        <- do.call(rbind, expr_blocks)
cat("Combining cluster labels...\n")
cluster_labels     <- unlist(meta_blocks, use.names = FALSE)
cat("Combining cell IDs...\n")
cell_ids           <- unlist(cellid_blocks, use.names = FALSE)
cat("Combining file provenance...\n")
file_provenance    <- unlist(provenance_blocks, use.names = FALSE)

# ---- 4) Save results ----
cat("Saving FlowSOM results...\n")
cat("Expression matrix:", nrow(expr_matrix), "cells x", ncol(expr_matrix), "markers\n")
cat("Cluster labels:", length(unique(cluster_labels)), "unique clusters\n")

# Save to RDS
saveRDS(list(
  expression_matrix = expr_matrix,
  cluster_labels = cluster_labels,
  cell_ids = cell_ids,
  file_provenance = file_provenance,
  marker_names = marker_names,
  som_object = fsom,
  meta_clusters = meta
), file = file.path(results_path, "flowsom_results.rds"))

cat("FlowSOM clustering complete!\n")
